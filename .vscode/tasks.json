{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build max bandwidth solver",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "main.c",
                "graph.c",
                "input.c",
                "-o",
                "max_bandwidth.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run graph tests",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "tests/test_graph.c",
                "graph.c",
                "-o",
                "graph_tests.exe"
            ],
            "group": "test",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
